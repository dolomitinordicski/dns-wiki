{
  "name": "dns-wiki",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:routes": "node scripts/check-routes.mjs",
    "check:foundation": "node scripts/foundation-lock.mjs --installed && node --test tests/foundation-integration.test.mjs",
    "check": "npm run check:routes && npm run check:foundation && npm run build",
    "validate": "npm run check",
    "test:browser": "playwright test",
    "prebuild": "node scripts/render-foundation.mjs",
    "predev": "node scripts/render-foundation.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "@astrojs/starlight": "^0.36.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/roboto": "^5.2.0",
    "@dolomitinordicski/dns-shared-data": "github:dolomitinordicski/dns-shared-data#foundation-v1.4.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.12",
    "@playwright/test": "1.56.1"
  }
}
