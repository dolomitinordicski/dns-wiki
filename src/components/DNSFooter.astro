---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { renderFoundationFooter } from '../lib/foundation-server.mjs';
import { version } from '../../package.json';
const locale = Astro.locals.starlightRoute?.locale || 'it';
const footer = renderFoundationFooter({ locale, toolVersion: version });
---
<DefaultFooter {...Astro.props} />
<Fragment set:html={footer} />
