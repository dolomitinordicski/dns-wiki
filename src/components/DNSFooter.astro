---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
const locale = Astro.url.pathname.split('/').filter(Boolean)[1] || 'it';
const copy = {
  it: {help:'Supporto',guide:'Guide operative',rights:'Dolomiti NordicSki · Documentazione ufficiale'},
  de: {help:'Support',guide:'Bedienungsanleitungen',rights:'Dolomiti NordicSki · Offizielle Dokumentation'},
  en: {help:'Support',guide:'User guides',rights:'Dolomiti NordicSki · Official documentation'},
}[locale] || {help:'Support',guide:'User guides',rights:'Dolomiti NordicSki · Official documentation'};
---
<DefaultFooter {...Astro.props}><slot /></DefaultFooter>
<footer class="dns-wiki-footer" aria-label="Dolomiti NordicSki">
  <div class="dns-wiki-footer__inner">
    <div class="dns-wiki-footer__brand">
      <strong>DNS Wiki</strong>
      <span>{copy.rights}</span>
    </div>
    <nav aria-label={copy.guide}>
      <a href={`${import.meta.env.BASE_URL}${locale}/`}>{copy.guide}</a>
      <a href="mailto:info@dolomitinordicski.com">{copy.help}</a>
    </nav>
  </div>
</footer>
