---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import { foundationLogoUrl } from '../lib/foundation-server.mjs';
const base = import.meta.env.BASE_URL;
const locale = Astro.locals.starlightRoute?.locale || 'it';
---
<div class="dns-foundation-header" data-dns-tool-header>
  <div class="dns-tool-header-shell">
    <a class="dns-tool-header-brand" href={`${base}${locale}/`} aria-label="Dolomiti NordicSki Wiki">
      <img class="dns-tool-header-logo" src={foundationLogoUrl} alt="Dolomiti NordicSki" width="120" height="40" />
      <span class="dns-tool-header-identity">
        <span class="dns-tool-header-title"><strong>DNS</strong><span> Wiki</span></span>
      </span>
    </a>
    <div class="dns-wiki-starlight-controls"><DefaultHeader {...Astro.props} /></div>
    <div class="dns-tool-header-controls" data-dns-accessibility-mount></div>
  </div>
</div>
<script>
  import '../lib/foundation-client';
</script>
